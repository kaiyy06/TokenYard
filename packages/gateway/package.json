{
  "name": "@tokenyard/gateway",
  "version": "0.0.0",
  "description": "Local pass-through gateway for coding agents (Anthropic and OpenAI formats).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiyy06/TokenYard.git",
