{
  "name": "@tokenyard/decider",
  "version": "0.0.0",
  "description": "Typed client for System One decision models (Jev, Kev, Solar Decide) over the /v1/systemone API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiyy06/TokenYard.git",
    "directory": "packages/decider"
  },
  "keywords": [
    "systemone",
    "decision-model",
    "jev",
    "kev",
    "llm-routing"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
