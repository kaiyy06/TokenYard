{
  "name": "tokenyard-monorepo",
  "private": true,
  "description": "Route coding-agent requests to the cheapest model that can do the job, using decision models.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiyy06/TokenYard.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "record": "pnpm --filter @tokenyard/recorder build && node packages/recorder/dist/cli.mjs record",
    "scrub": "pnpm --filter @tokenyard/recorder build && node packages/recorder/dist/cli.mjs scrub",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.4",
    "publint": "^0.3.24",
    "typescript": "7.0.2",
    "unrun": "^0.3.1",
    "vitest": "5.0.2"
  }
}
